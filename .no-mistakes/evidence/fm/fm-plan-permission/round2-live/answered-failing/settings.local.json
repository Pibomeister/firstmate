{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{run-worktree}/bin/fm-permission-route.sh claude-request /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state task 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sleep 2; printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state/task.permission-held ] || {run-worktree}/bin/fm-permission-route.sh claude-settled /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state task tool-finished 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -e /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state/task.permission-held ] || {run-worktree}/bin/fm-permission-route.sh claude-settled /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state task tool-finished 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{run-worktree}/bin/fm-permission-route.sh claude-settled /private/var/folders/93/6w1bxqxn2yb92mt6rmt5zbzw0000gn/T/fm-permission-route-live.PX5gTO/answered-failing/home/state task session-end 2>/dev/null || true"
          }
        ]
      }
    ]
  }
