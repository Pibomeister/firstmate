    {
      line = $0; out = ""; n = length(line); i = 1
      while (i <= n) {
        c = substr(line, i, 1)
        if (c == "\342" && i + 2 <= n) {
          c2 = substr(line, i + 1, 1); c3 = substr(line, i + 2, 1)
          if (c2 >= "\240" && c2 <= "\243" && c3 >= "\200" && c3 <= "\277") {
            i += 3; continue
          }
        }
        out = out c; i++
      }
      print out
    }
