--- delta patch ---
diff --git a/parse_port.py b/parse_port.py
index aeb52582e0258113ce2a78011a9b4eccf6d04cf1..3cf5a922064a06aea3512ba8e51175d129170418 100644
--- a/parse_port.py
+++ b/parse_port.py
@@ -1,3 +1,7 @@
 def parse_port(value: str) -> int:
-    # Bug: does not validate port range 1..65535
-    return int(value)
+    if not isinstance(value, str) or not value.isascii() or not value.isdigit():
+        raise ValueError(f"invalid port: {value!r}")
+    port = int(value)
+    if port < 1 or port > 65535:
+        raise ValueError(f"port out of range: {port}")
+    return port
diff --git a/test_parse_port.py b/test_parse_port.py
new file mode 100644
index 0000000000000000000000000000000000000000..8100749c4fb6c6198ded6da78c1d3fd90849b90e
--- /dev/null
+++ b/test_parse_port.py
@@ -0,0 +1,16 @@
+import unittest
+from parse_port import parse_port
+
+class TestParsePort(unittest.TestCase):
+    def test_valid(self):
+        self.assertEqual(parse_port("1"), 1)
+        self.assertEqual(parse_port("80"), 80)
+        self.assertEqual(parse_port("65535"), 65535)
+
+    def test_invalid(self):
+        for bad in ("", "0", "-1", "65536", " 80", "80 ", "1_0", "abc", "\u0668\u0660"):
+            with self.assertRaises(ValueError):
+                parse_port(bad)
+
+if __name__ == "__main__":
+    unittest.main()
