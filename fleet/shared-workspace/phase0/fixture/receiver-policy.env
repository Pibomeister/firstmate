# Receiver-side adoption policy. Authority to adopt comes only from this file,
# which machine B's operator holds; nothing inside a transfer bundle can widen
# it (refinements 3 and 4).
ALLOW_SESSION_REGEX='^p0-[a-z0-9-]+$'
ALLOW_SENDER_OS_REGEX='^(Darwin|Linux)$'
MAX_ARTIFACT_BYTES=67108864          # 64 MiB per adopted artifact
MAX_ADOPTED_SESSIONS=4               # sessions this home may hold from adoption
